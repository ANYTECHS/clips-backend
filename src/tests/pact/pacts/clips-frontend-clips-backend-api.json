{
  "consumer": {
    "name": "clips-frontend"
  },
  "interactions": [
    {
      "description": "a clip-generation job request",
      "providerState": "the user is below the active job limit",
      "request": {
        "body": {
          "videoId": 7
        },
        "headers": {
          "Authorization": "Bearer test-token",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/clips/generate"
      },
      "response": {
        "body": {
          "jobId": "clip-123",
          "queue": "clip-generation",
          "status": "queued"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 201
      }
    },
    {
      "description": "a login request with a wrong password",
      "providerState": "a registered user exists",
      "request": {
        "body": {
          "email": "founder@example.com",
          "password": "wrong-password"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/auth/login"
      },
      "response": {
        "body": {
          "message": "Invalid credentials",
          "statusCode": 401
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 401
      }
    },
    {
      "description": "a login request with valid credentials",
      "providerState": "a registered user exists",
      "request": {
        "body": {
          "email": "founder@example.com",
          "password": "Sup3rSecret!"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/auth/login"
      },
      "response": {
        "body": {
          "accessToken": "eyJhbGciOiJIUzI1NiJ9...",
          "refreshToken": "a1b2c3d4e5f6..."
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "a payout request",
      "providerState": "the user has sufficient balance",
      "request": {
        "body": {
          "amount": 100,
          "currency": "USD",
          "method": "stellar"
        },
        "headers": {
          "Authorization": "Bearer test-token",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/payouts/request"
      },
      "response": {
        "body": {
          "amount": 100,
          "currency": "USD",
          "id": 10,
          "status": "pending"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 201
      }
    },
    {
      "description": "a request to list clips",
      "providerState": "the user has clips",
      "request": {
        "headers": {
          "Authorization": "Bearer test-token"
        },
        "method": "GET",
        "path": "/clips",
        "query": "page=1"
      },
      "response": {
        "body": [
          {
            "id": 42,
            "royaltyBps": 500,
            "status": "ready",
            "title": "My clip",
            "videoId": 7
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "a request to list earnings",
      "providerState": "the user has earnings",
      "request": {
        "headers": {
          "Authorization": "Bearer test-token"
        },
        "method": "GET",
        "path": "/earnings"
      },
      "response": {
        "body": [
          {
            "amount": 12.5,
            "clipId": 42,
            "currency": "USD",
            "id": 1,
            "source": "royalty"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "a request to list videos",
      "providerState": "the user has uploaded videos",
      "request": {
        "headers": {
          "Authorization": "Bearer test-token"
        },
        "method": "GET",
        "path": "/videos"
      },
      "response": {
        "body": [
          {
            "id": 7,
            "status": "processed",
            "title": "Source video"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "a request to list wallets",
      "providerState": "the user has a connected wallet",
      "request": {
        "headers": {
          "Authorization": "Bearer test-token"
        },
        "method": "GET",
        "path": "/wallets"
      },
      "response": {
        "body": [
          {
            "address": "GABC123",
            "chain": "stellar",
            "id": 1,
            "type": "custodial"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "an NFT mint request",
      "providerState": "the collection allows minting",
      "request": {
        "body": {
          "metadata": {
            "name": "Clip #42"
          },
          "to": "GABC123"
        },
        "headers": {
          "Authorization": "Bearer test-token",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/nfts/mint"
      },
      "response": {
        "body": {
          "jobId": "mint-1",
          "status": "queued"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 201
      }
    },
    {
      "description": "another clip-generation job request",
      "providerState": "the user has reached the maximum of 5 active jobs",
      "request": {
        "body": {
          "videoId": 8
        },
        "headers": {
          "Authorization": "Bearer test-token",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/clips/generate"
      },
      "response": {
        "body": {
          "message": "Too many active jobs (max 5)",
          "statusCode": 429
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 429
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.5.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "2.0.0"
    }
  },
  "provider": {
    "name": "clips-backend-api"
  }
}